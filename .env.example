# Copy to .env and fill in your own free-tier tokens. NEVER commit .env.
# Apify — used by the LIHKG actor route (src/lihkg.py) and the Telegram
# keyword-search / channel actors (src/telegram_apify.py). The LIHKG
# public api_v2 route and all price ingestion work without it.
APIFY_API_TOKEN=
# Exa — the brief's named news source (src/news.py). Used when set.
EXA_API_KEY=
# Tavily — fallback news search, used only when EXA_API_KEY is not set.
TAVILY_API_KEY=
